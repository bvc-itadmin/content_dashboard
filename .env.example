# Copy to .env.local for testing on your own computer. Never commit real values.
# On Vercel, add the same names under Settings > Environment Variables instead.

# Address of the website the dashboard publishes to
WP_URL=http://bvcglobal.local

# Random text that signs the sign-in cookie (32+ characters)
SESSION_SECRET=

# Shared key. The same value goes into the website's wp-config.php as BVC_DASHBOARD_API_KEY
DASHBOARD_API_KEY=
